<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" не отключает перенос данных на новое
     устройство, поэтому хранилище токенов (flutter_secure_storage)
     исключаем явно. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
